# Copy to .env and fill in. Never commit .env.
DATABASE_PATH=prospects.db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sent in the scanner's User-Agent so site owners can contact you (email or URL).
CRAWLER_CONTACT=
CRAWLER_MIN_DELAY_SECONDS=3
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_PAGES_PER_SITE=3

# Optional: Google Places API (New). Restrict the key to the Places API in Google Cloud.
GOOGLE_PLACES_API_KEY=
# Days Places content other than place IDs may be stored. 0 = place IDs only.
# Only raise this if your reading of the current Google Maps Platform terms allows it.
GOOGLE_PLACES_CACHE_DAYS=0

# Optional: OpenStreetMap Overpass endpoint.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: Claude rewrite of audit wording (requires `pip install anthropic`).
ANTHROPIC_API_KEY=
AUDIT_LLM_MODEL=claude-opus-5-5
# Your name, company and physical postal address for outreach emails.
AUDIT_SIGNATURE=

# Bulk website checks.
CHECK_BATCH_SIZE=10
CHECK_CONCURRENCY=3
CHECK_MAX_RETRIES=2
CHECK_SITE_TIME_LIMIT_SECONDS=120
CHECK_FAILED_RETRY_HOURS=24
CHECK_MAX_FAILED_ATTEMPTS=3
